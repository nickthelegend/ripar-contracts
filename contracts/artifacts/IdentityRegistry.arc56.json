    "methods": [
        {
            "name": "new_agent",
            "args": [
                {
                    "type": "string",
                    "name": "agent_domain"
                }
            ],
            "returns": {
                "type": "uint64"
            },
            "actions": {
                "create": [],
                "call": [
                    "NoOp"
                ]
            },
            "readonly": false,
            "desc": "Register the caller as an agent and return its new id.\nThe address is taken from the sender rather than an argument: a registration that anyone could make on anyone's behalf is not identity, it is a phone book.",
            "events": [],
            "recommendations": {}
        },
        {
            "name": "update_agent",
            "args": [
                {
                    "type": "uint64",
                    "name": "agent_id"
                },
                {
                    "type": "string",
                    "name": "new_domain"
                }
            ],
            "returns": {
                "type": "bool"
            },
            "actions": {
                "create": [],
                "call": [
                    "NoOp"
                ]
            },
            "readonly": false,
            "desc": "Move an agent to a new domain. Only its own address may do this.",
            "events": [],
            "recommendations": {}
        },
        {
            "name": "get_agent",
            "args": [
                {
                    "type": "uint64",
                    "name": "agent_id"
                }
            ],
            "returns": {
                "type": "(uint64,string,address,uint64,uint64)",
                "struct": "AgentInfo"
            },
            "actions": {
                "create": [],
                "call": [
                    "NoOp"
                ]
            },
            "readonly": true,
            "events": [],
            "recommendations": {}
        },
        {
            "name": "deregister_agent",
            "args": [
                {
                    "type": "uint64",
                    "name": "agent_id"
                }
            ],
            "returns": {
                "type": "bool"
            },
            "actions": {
                "create": [],
                "call": [
                    "NoOp"
                ]
            },
            "readonly": false,
            "desc": "Remove your own agent, freeing the three boxes it occupies.\nOnly the controlling address, because new_agent took the owner from Txn.sender and this has to be the same authority in reverse. Without it a typo'd domain is permanent: new_agent asserts one identity per address, so the owner cannot re-register and cannot remove the old one either \u2014 the id is stranded and the box minimum-balance with it.\nThe id is NOT reused. agent_count only ever climbs, so a stale reference resolves to nothing rather than silently pointing at whoever registered next.",
            "events": [],
            "recommendations": {}
        },
        {
            "name": "agent_address",
            "args": [
                {
                    "type": "uint64",
                    "name": "agent_id"
                }
            ],
            "returns": {
                "type": "address"
            },
            "actions": {
                "create": [],
                "call": [
                    "NoOp"
                ]
            },
            "readonly": true,
            "desc": "Just the controlling address. Exists for cross-contract callers.\n`get_agent` returns the whole record, including a dynamic string, which another contract would have to decode to reach the one field it wants. This returns a fixed 32 bytes, so ReputationRegistry can bind a payment to the agent it credits in a single inner call.\nAsserts rather than returning the zero address: a caller that treated \"not found\" as an address would compare it against a real one and get a silent mismatch instead of a reason.",
            "events": [],
            "recommendations": {}
        },
        {
            "name": "resolve_by_domain",
            "args": [
                {
                    "type": "string",
                    "name": "agent_domain"
                }
            ],
            "returns": {
                "type": "uint64"
            },
            "actions": {
                "create": [],
                "call": [
                    "NoOp"
                ]
            },
            "readonly": true,
            "desc": "0 means not found \u2014 callers must check rather than trust the id.",
            "events": [],
            "recommendations": {}
        },
        {
            "name": "resolve_by_address",
            "args": [
                {
                    "type": "address",
                    "name": "agent_address"
                }
            ],
            "returns": {
                "type": "uint64"
            },
            "actions": {
                "create": [],
                "call": [
                    "NoOp"
                ]
            },
            "readonly": true,
            "events": [],
            "recommendations": {}
        },
        {
            "name": "total_agents",
            "args": [],
            "returns": {
                "type": "uint64"
            },
            "actions": {
                "create": [],
                "call": [
                    "NoOp"
                ]
            },
            "readonly": true,
            "events": [],
            "recommendations": {}
        }
    ],
