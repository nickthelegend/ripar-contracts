            "readonly": false,
            "desc": "Point at the Identity Registry and fix the settlement asset.\nThe asset is set once and never changed, so a score always means the same thing. Without it accept_feedback would have to trust whatever asset a caller transferred, and reputation could be bought with a worthless one minted for the purpose.",
            "events": [],
            "recommendations": {}
        },
        {
            "name": "accept_feedback",
            "args": [
                {
                    "type": "axfer",
                    "name": "payment"
                },
                {
                    "type": "uint64",
                    "name": "server_agent_id"
                },
                {
                    "type": "uint64",
                    "name": "client_agent_id"
                }
            ],
            "returns": {
                "type": "uint64"
            },
            "actions": {
                "create": [],
                "call": [
                    "NoOp"
                ]
            },
            "readonly": false,
            "desc": "Credit a server agent for one settled payment. Returns its new count.\nThe payment is passed as a TRANSACTION IN THIS GROUP, not as an id and an amount the caller supplies. That distinction is the whole point.\nThe previous signature took a 32-byte id and a number, and checked only that the id was 32 bytes long and unseen. Nothing tied either value to a transfer that had actually happened, so any 32 bytes bought a point of reputation \u2014 an audit found two counted payments on TestNet that resolve to no transaction at all, one of them 32 zero bytes. The docstring claiming a score \"cannot be inflated by anything that did not move USDC\" was simply untrue.\nNow the amount and the id are READ OFF the transfer the AVM has already validated, so they cannot be fabricated: to earn a point you must move the asset, in the same atomic group, in the same round.",
            "events": [],
            "recommendations": {}
        },
        {
            "name": "record_validation",
            "args": [
                {
                    "type": "uint64",
                    "name": "server_agent_id"
                },
                {
                    "type": "bool",
                    "name": "passed"
                }
            ],
            "returns": {
                "type": "bool"
            },
            "actions": {
                "create": [],
                "call": [
                    "NoOp"
                ]
            },
            "readonly": false,
            "desc": "Called by the Validation Registry once a result is judged.",
            "events": [],
            "recommendations": {}
        },
        {
            "name": "get_score",
            "args": [
                {
                    "type": "uint64",
                    "name": "agent_id"
                }
            ],
            "returns": {
                "type": "(uint64,uint64,uint64,uint64,uint64,uint64,uint64)",
